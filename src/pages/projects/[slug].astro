---
import { type CollectionEntry, getCollection } from 'astro:content';
import Article from '../../layouts/Article.astro';
import { sortItemsByDateDesc } from '../../utils/content';

export async function getStaticPaths() {
    const projects = (await getCollection('projects')).sort(sortItemsByDateDesc);
    return projects.map((entry, i) => ({
        params: { slug: entry.slug },
        props: { entry, next: projects[i - 1], prev: projects[i + 1] }
    }));
}

type Props = { entry: CollectionEntry<'projects'>; prev?: CollectionEntry<'projects'>; next?: CollectionEntry<'projects'> };

const { entry, prev, next } = Astro.props;
const { Content } = await entry.render();
---

<Article entry={entry} section="projects" prev={prev} next={next}>
    <Content />
</Article>
