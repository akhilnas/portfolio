---
import { getCollection } from 'astro:content';
import EntryList from '../components/EntryList.astro';
import { site } from '../data/site';
import Base from '../layouts/Base.astro';
import { sortItemsByDateDesc, url } from '../utils/content';

const posts = (await getCollection('blog')).sort(sortItemsByDateDesc);
const projects = (await getCollection('projects')).sort(sortItemsByDateDesc);

const latest = (items: typeof posts | typeof projects, n: number) => {
    const featured = items.filter((i) => i.data.isFeatured);
    return (featured.length ? featured : items).slice(0, n);
};
---

<Base marginRule>
    <section class="home-intro">
        <h1>Hi, I'm Akhil.</h1>
        <p>{site.intro}</p>
        <ul class="socials">
            {
                site.socials.map((s) => (
                    <li>
                        <a href={s.href} rel="me noopener">
                            {s.text}
                        </a>
                    </li>
                ))
            }
        </ul>
    </section>

    <section class="section">
        <div class="section-title">
            <h2>Writing</h2>
            <a href={url('writing')}>all {posts.length} posts →</a>
        </div>
        <EntryList items={posts.slice(0, 4)} section="writing" />
    </section>

    <section class="section">
        <div class="section-title">
            <h2>Projects</h2>
            <a href={url('projects')}>all projects →</a>
        </div>
        <EntryList items={latest(projects, 3)} section="projects" />
    </section>
</Base>
