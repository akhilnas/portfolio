---
import { site } from '../data/site';
import { url } from '../utils/content';

const path = Astro.url.pathname;
const isCurrent = (href: string) => path.startsWith(url(href));
---

<header class="nav">
    <nav class="nav-inner" aria-label="Main">
        <a class="nav-home" href={url()} aria-current={path === url() ? 'page' : undefined}>
            <span class="seal" aria-hidden="true"></span>Home
        </a>
        <button class="theme-toggle" type="button" aria-label="Toggle dark mode">
            <svg class="moon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.4 14.6A8.5 8.5 0 0 1 9.4 3.6a8.5 8.5 0 1 0 11 11Z"></path></svg>
            <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                <circle cx="12" cy="12" r="4.2"></circle>
                <path d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4"></path>
            </svg>
        </button>
        <ul class="nav-links">
            {
                site.nav.map((item) => (
                    <li class={item.href === 'about' ? undefined : 'secondary'}>
                        <a href={url(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                            {item.text}
                        </a>
                    </li>
                ))
            }
        </ul>
    </nav>
</header>

<!-- Section divider tabs on the right edge; replace .nav-links on wide screens -->
<nav class="tabs" aria-label="Sections">
    {
        site.nav.map((item) => (
            <a href={url(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.text}
            </a>
        ))
    }
</nav>
