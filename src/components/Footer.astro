---
import { site } from '../data/site';
import { pageNumber, url } from '../utils/content';
import Squiggle from './Squiggle.astro';

const page = await pageNumber(Astro.url.pathname);
---

<footer class="footer">
    <Squiggle />
    <ul>
        {
            site.socials.map((s) => (
                <li>
                    <a href={s.href} rel="me noopener">
                        {s.text}
                    </a>
                </li>
            ))
        }
        <li><a href={url('contact')}>Contact</a></li>
        <li><a href={`${url()}rss.xml`}>RSS</a></li>
    </ul>
    <p class="small-caps">© {new Date().getFullYear()} {site.author}</p>
    {page && <span class="page-number" aria-label={`Page ${page}`}>{page}</span>}
</footer>
