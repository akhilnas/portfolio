---
import { site } from '../data/site';
import { url } from '../utils/content';
import Squiggle from './Squiggle.astro';
---

<footer class="footer">
    <Squiggle />
    <ul>
        {
            site.socials.map((s) => (
                <li>
                    <a href={s.href} rel="me noopener">
                        {s.text}
                    </a>
                </li>
            ))
        }
        <li><a href={url('contact')}>Contact</a></li>
        <li><a href={`${url()}rss.xml`}>RSS</a></li>
    </ul>
    <p class="small-caps">© {new Date().getFullYear()} {site.author}</p>
</footer>
